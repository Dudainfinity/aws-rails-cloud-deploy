<div style="font-family: sans-serif; max-width: 800px; margin: 60px auto; text-align: center;">
  <h1>AWS Rails Cloud Deploy</h1>
  <p style="font-size: 1.2em; color: #555;">Deploy manual de Ruby on Rails na AWS EC2</p>

  <div style="margin-top: 40px; display: flex; justify-content: center; gap: 20px; flex-wrap: wrap;">
    <div style="background: #f4f4f4; border-radius: 8px; padding: 20px; width: 180px;">
      <h3>Ruby on Rails</h3>
      <p>Framework web</p>
    </div>
    <div style="background: #f4f4f4; border-radius: 8px; padding: 20px; width: 180px;">
      <h3>PostgreSQL</h3>
      <p>Banco de dados</p>
    </div>
    <div style="background: #f4f4f4; border-radius: 8px; padding: 20px; width: 180px;">
      <h3>Nginx</h3>
      <p>Reverse proxy</p>
    </div>
    <div style="background: #f4f4f4; border-radius: 8px; padding: 20px; width: 180px;">
      <h3>AWS EC2</h3>
      <p>Servidor cloud</p>
    </div>
  </div>

  <p style="margin-top: 40px; color: #888;">Ambiente: <%= Rails.env %></p>
</div>
