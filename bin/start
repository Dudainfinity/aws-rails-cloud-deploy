#!/bin/bash -e

# Prepara todos os bancos (primary, cache, queue, cable)
./bin/rails db:prepare
./bin/rails db:prepare:cache db:prepare:queue db:prepare:cable 2>/dev/null || true

# Inicia o Puma em background na porta 3000
./bin/rails server -b 127.0.0.1 -p 3000 &

# Aguarda o Puma ficar disponível
echo "Aguardando Puma iniciar..."
until curl -s http://127.0.0.1:3000/up > /dev/null 2>&1; do
  sleep 1
done
echo "Puma iniciado."

# Inicia o Nginx em foreground
exec nginx -g "daemon off;"
